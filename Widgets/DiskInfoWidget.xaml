<local:BaseWidget x:Class="UnitDesk.Widgets.DiskInfoWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnitDesk.Widgets"
        Title="Disk Info Widget" Height="200" Width="300" 
        Background="#33000000" WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="10" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Background="#44000000" CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="Disk Information" Foreground="White" 
                               Margin="10,5" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟲" Width="20" Height="20" Margin="0,0,5,0" Padding="0"
                                Click="ResetButton_Click" ToolTip="Reset Position"/>
                        <Button Content="✕" Width="20" Height="20" Margin="0,0,5,0" Padding="0"
                                Click="CloseButton_Click" ToolTip="Close Widget"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DiskList" Foreground="White">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</local:BaseWidget>
